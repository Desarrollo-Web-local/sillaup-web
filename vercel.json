{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["gru1"],
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "sillaup.cl" }],
      "destination": "https://www.sillaup.cl/:path*",
      "statusCode": 301
    },
    {
      "source": "/kit-elevador-wc-:n(\\d+)",
      "destination": "/productos",
      "statusCode": 301
    },
    {
      "source": "/grua-manual",
      "destination": "/productos/traslado-de-pacientes",
      "statusCode": 301
    },
    {
      "source": "/elevador-de-cama",
      "destination": "/productos/cuidado-en-cama",
      "statusCode": 301
    }
  ]
}
