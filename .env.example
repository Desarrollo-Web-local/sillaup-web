# Copia este archivo como .env.local y completa los valores.
# En Vercel: Project Settings > Environment Variables.

# URL pública del sitio (para metadatos y sitemap)
NEXT_PUBLIC_SITE_URL=https://sillaup.cl

# Supabase > Project Settings > API Keys (usar la clave "publishable": sb_publishable_...)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
